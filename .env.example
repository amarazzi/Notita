# Podés generar este archivo solo, sin copiar nada a mano:  python3 install.py

# Token que da BotFather
TELEGRAM_TOKEN=123456:ABC-DEF...

# Cualquier string largo inventado. Telegram lo manda en cada request del webhook.
TELEGRAM_WEBHOOK_SECRET=algo-largo-y-random

# chat_id del grupo (es negativo, ej: -1001234567890). Sacalo con /chatid
ALLOWED_CHAT_ID=-1001234567890

# Quiénes viven en la casa: Nombre:user_id, separados por coma.
# Acepta cualquier cantidad de personas (una, dos, cinco).
# El user_id lo saca install.py solo, o te lo dice @userinfobot.
NOTITA_PERSONAS=Axel:11111111,Barbu:22222222

# Contexto libre de la casa, para que el LLM acierte mejor (opcional)
# NOTITA_CONTEXTO=Tenemos un gato que se llama Milo. Vivimos en un PH con patio.

# Clave para que un cron externo dispare los recordatorios de las 20:00.
# Vacío = la ruta /cron/recordatorios queda apagada (usá la tarea diaria de PythonAnywhere).
CRON_SECRET=

# API key de Google AI Studio (capa gratuita)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Ruta de la base (opcional)
# NOTITA_DB=/home/USUARIO/Notita/notita.db
